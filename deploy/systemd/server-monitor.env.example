# /etc/server-monitor/server-monitor.env  (chmod 0640, root:monitor)

# --- wymagane dla `serve`: dane dostępu do chronionych endpointów ---
# Bearer token (min. 16 znaków), np. `openssl rand -hex 24`
SM_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
# lub/oraz Basic Auth (przeglądarka pokaże okno logowania dla frontendu)
#SM_BASIC_USER=admin
#SM_BASIC_PASSWORD=CHANGE_ME

# GET /api/health bez uwierzytelniania (domyślnie false)
HEALTH_PUBLIC=false

SM_LISTEN=127.0.0.1:8080
SM_DB_PATH=/var/lib/server-monitor/state.db
# Odświeżanie sond w tle: 10s..15s
#SM_REFRESH_INTERVAL=12s

# --- sondy opcjonalne (włączone tylko gdy ustawione) ---
#ES_URL=http://127.0.0.1:9200
#ES_USER=
#ES_PASSWORD=
#ES_API_KEY=
#KIBANA_URL=http://127.0.0.1:5601
#KIBANA_USER=
#KIBANA_PASSWORD=
#KIBANA_API_KEY=
#REDIS_ADDR=127.0.0.1:6379       # lub ścieżka gniazda + REDIS_NETWORK=unix
#REDIS_NETWORK=tcp
#REDIS_PASSWORD=

# supervisor: domyślnie /var/run/supervisor.sock jeśli istnieje; "off" wyłącza
#SUPERVISOR_SOCKET=/var/run/supervisor.sock
# audit.log: domyślnie /var/log/audit/audit.log; "off" wyłącza
#SM_AUDIT_LOG=/var/log/audit/audit.log
